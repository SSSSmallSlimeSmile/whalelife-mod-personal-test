+import { receiptPath, verifiedFiles, type WriteReceipt } from "../core/receipts.ts";
+
+const made: string[] = [];
+const root = () => { const d = mkdtempSync(join(tmpdir(), "whalelife-receipts-")); made.push(d); return d; };
+after(() => { for (const dir of made) { try { rmSync(dir, { recursive: true, force: true }); } catch {} } });
+const sha = (body: string) => createHash("sha256").update(Buffer.from(body, "utf8")).digest("hex");
+const receipt = (path: string, body: string, over: Partial<WriteReceipt> = {}): WriteReceipt => ({
+  kind: "file_write", tool: "hands_write", plugin: "hands", call_id: "call-1", round: 1,
+  path, bytes: Buffer.byteLength(body), sha256: sha(body), read_back: "ok", ...over,
+});
+
+test("写成功后回读通过的文件才列进本轮文件", async () => {
+  const dir = root();
+  mkdirSync(join(dir, "out"), { recursive: true });
+  writeFileSync(join(dir, "out/a.md"), "# 标题");
+  const files = await verifiedFiles(dir, [receipt("out/a.md", "# 标题")]);
+  assert.equal(files.length, 1);
+  assert.equal(files[0].path, "out/a.md");
+  assert.equal(files[0].name, "a.md");
+  assert.equal(files[0].ok, true);
+  assert.equal(files[0].bytes, Buffer.byteLength("# 标题"));
+});
+
+test("零回执时本轮文件是空的：界面就不会出现列表", async () => {
+  const dir = root();
+  writeFileSync(join(dir, "out.md"), "x");
+  assert.deepEqual(await verifiedFiles(dir, []), []);
+});
+
+test("回读失败照实显示原因，不给打开入口", async () => {
+  const dir = root();
+  const files = await verifiedFiles(dir, [
+    { kind: "file_write", tool: "hands_write", plugin: "hands", call_id: "call-1", round: 1,
+      path: "out/a.md", read_back: "failed", error: "EACCES" },
+  ]);
+  assert.equal(files[0].ok, false);
+  assert.match(String(files[0].error), /回读失败.*EACCES/);
+});
+
+test("写入后文件又被改动，回执那一版对不上就不算已验证", async () => {
+  const dir = root();
+  mkdirSync(join(dir, "out"), { recursive: true });
+  writeFileSync(join(dir, "out/a.md"), "写进去的");
+  writeFileSync(join(dir, "out/a.md"), "被人改了");
+  const files = await verifiedFiles(dir, [receipt("out/a.md", "写进去的")]);
+  assert.equal(files[0].ok, false);
+  assert.match(String(files[0].error), /已变化/);
+});
+
+test("核验时文件不见了，报不存在", async () => {
+  const dir = root();
+  mkdirSync(join(dir, "out"), { recursive: true });
+  writeFileSync(join(dir, "out/a.md"), "x");
+  const files = await verifiedFiles(dir, [receipt("out/a.md", "x")]);
+  rmSync(join(dir, "out/a.md"));
+  const again = await verifiedFiles(dir, [receipt("out/a.md", "x")]);
+  assert.equal(files[0].ok, true);
+  assert.equal(again[0].ok, false);
+  assert.match(String(again[0].error), /不存在/);
+});
+
+test("同一路径取最后一条回执", async () => {
+  const dir = root();
+  mkdirSync(join(dir, "out"), { recursive: true });
+  writeFileSync(join(dir, "out/a.md"), "第二版");
+  const files = await verifiedFiles(dir, [
+    receipt("out/a.md", "第一版", { call_id: "call-1", round: 1 }),
+    receipt("out/a.md", "第二版", { call_id: "call-2", round: 2 }),
+  ]);
+  assert.equal(files.length, 1);
+  assert.equal(files[0].ok, true);
+});
+
+test("两份文件各列一行", async () => {
+  const dir = root();
+  mkdirSync(join(dir, "out"), { recursive: true });
+  writeFileSync(join(dir, "out/a.md"), "甲");
+  writeFileSync(join(dir, "out/b.patch"), "乙");
+  const files = await verifiedFiles(dir, [receipt("out/a.md", "甲"), receipt("out/b.patch", "乙")]);
+  assert.deepEqual(files.map((file) => file.name), ["a.md", "b.patch"]);
+});
+
+test("路径越界不收，工作目录内的绝对路径收敛成相对路径", () => {
+  const dir = root();
+  assert.equal(receiptPath(dir, join(dir, "out", "a.md")), "out/a.md");
+  assert.equal(receiptPath(dir, resolve(dir, "..", "escape.md")), undefined);
+  assert.equal(receiptPath(dir, dir), undefined);
+  assert.equal(receiptPath(dir, ""), undefined);
+});
