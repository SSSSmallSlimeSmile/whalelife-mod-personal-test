diff --git a/cdp_chrome.cjs b/cdp_chrome.cjs
new file mode 100644
index 0000000..d984a12
--- /dev/null
+++ b/cdp_chrome.cjs
@@ -0,0 +1,59 @@
+// 常驻无头 Chrome 管理：node cdp_chrome.cjs start|status|stop [port]
+const { spawn, execSync } = require('child_process');
+const fs = require('fs');
+const path = require('path');
+
+const CHROME = 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe';
+const cmd = (process.argv[2] || 'status').toLowerCase();
+const port = parseInt(process.argv[3] || '9222', 10);
+const prof = path.join(__dirname, 'cdp_prof_' + port);
+
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+async function version() {
+  try {
+    const r = await fetch(`http://127.0.0.1:${port}/json/version`, { signal: AbortSignal.timeout(3000) });
+    return await r.json();
+  } catch (_) { return null; }
+}
+
+async function handleStart() {
+  const v0 = await version();
+  if (v0) {
+    console.log(`already running on ${port}: ${v0['Browser']}`);
+    return;
+  }
+  fs.mkdirSync(prof, { recursive: true });
+  const child = spawn(CHROME, [
+    '--headless=new',
+    '--remote-debugging-port=' + port,
+    '--remote-debugging-address=127.0.0.1',
+    '--disable-gpu',
+    '--no-first-run', '--no-default-browser-check', '--noerrdialogs',
+    '--disable-background-timer-throttling',
+    '--user-data-dir=' + prof,
+    'about:blank',
+  ], { detached: true, stdio: 'ignore' });
+  child.unref();
+  console.log('spawned pid=' + child.pid);
+
+  for (let i = 0; i < 40; i++) {
+    await sleep(250);
+    const v = await version();
+    if (v) { console.log(`up on ${port}: ${v['Browser']}`); return; }
+  }
+  console.log('TIMEOUT: port never opened');
+  process.exitCode = 1;
+}
+
+if (cmd === 'start') handleStart();
+else if (cmd === 'status') {
+  version().then(v => console.log(v ? `up ${port}: ${v['Browser']}\nws: ${v.webSocketDebuggerUrl}` : `down ${port}`));
+}
+else if (cmd === 'stop') {
+  try {
+    execSync(`powershell -NoProfile -Command "Get-CimInstance Win32_Process -Filter \\"Name='chrome.exe'\\" | Where-Object { $_.CommandLine -like '*cdp_prof_${port}*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }"`, { stdio: 'ignore' });
+    console.log('stopped ' + port);
+  } catch (e) { console.log('stop err ' + e.message); }
+}
+else console.log('usage: start|status|stop [port]');
diff --git a/cdp_fetch.cjs b/cdp_fetch.cjs
new file mode 100644
index 0000000..056e6a7
--- /dev/null
+++ b/cdp_fetch.cjs
@@ -0,0 +1,79 @@
+// 用无头 Chrome + CDP 取渲染后的 DOM。用法:
+//   node cdp_fetch.js <url> <outfile> [port] [waitMs]
+const { spawn } = require('child_process');
+const fs = require('fs');
+const path = require('path');
+
+const CHROME = 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe';
+const url = process.argv[2];
+const out = process.argv[3] || 'page_dump.html';
+const port = parseInt(process.argv[4] || '9500', 10);
+const waitMs = parseInt(process.argv[5] || '9000', 10);
+
+if (!url) { console.error('need url'); process.exit(2); }
+
+const prof = path.join(__dirname, 'cdp_prof_' + port);
+const child = spawn(CHROME, [
+  '--headless=new',
+  '--remote-debugging-port=' + port,
+  '--disable-gpu', '--no-sandbox',
+  '--no-first-run', '--noerrdialogs',
+  '--user-data-dir=' + prof,
+  url,
+], { stdio: 'ignore', detached: false });
+
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+async function getWs() {
+  for (let i = 0; i < 60; i++) {
+    await sleep(300);
+    try {
+      const r = await fetch(`http://127.0.0.1:${port}/json/list`);
+      const list = await r.json();
+      const pg = list.find(t => t.type === 'page' && t.webSocketDebuggerUrl);
+      if (pg) return pg.webSocketDebuggerUrl;
+    } catch (_) {}
+  }
+  return null;
+}
+
+(async () => {
+  try {
+    const wsUrl = await getWs();
+    if (!wsUrl) { console.error('no cdp target'); process.exitCode = 1; return; }
+
+    const ws = new WebSocket(wsUrl);
+    await new Promise((res, rej) => { ws.onopen = res; ws.onerror = rej; });
+
+    const pending = new Map();
+    ws.onmessage = ev => {
+      const m = JSON.parse(ev.data);
+      if (m.id && pending.has(m.id)) { pending.get(m.id)(m); pending.delete(m.id); }
+    };
+    const send = (id, method, params) => new Promise(res => {
+      pending.set(id, res);
+      ws.send(JSON.stringify({ id, method, params }));
+    });
+
+    await sleep(waitMs);
+    const r = await send(1, 'Runtime.evaluate', {
+      expression: 'document.documentElement.outerHTML',
+      returnByValue: true,
+    });
+    const html = r?.result?.result?.value || '';
+    fs.writeFileSync(path.join(__dirname, out), html, 'utf8');
+    console.log(`len=${html.length} -> ${out}`);
+    ws.close();
+  } catch (e) {
+    console.error('ERR ' + e.message);
+    process.exitCode = 1;
+  } finally {
+    try { child.kill(); } catch (_) {}
+    await sleep(400);
+    // 收干净残留进程
+    try {
+      const { execSync } = require('child_process');
+      execSync(`powershell -NoProfile -Command "Get-CimInstance Win32_Process -Filter \\"Name='chrome.exe'\\" | Where-Object { $_.CommandLine -like '*cdp_prof_${port}*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }"`, { stdio: 'ignore' });
+    } catch (_) {}
+  }
+})();
diff --git a/cdp_get.cjs b/cdp_get.cjs
new file mode 100644
index 0000000..f3298f1
--- /dev/null
+++ b/cdp_get.cjs
@@ -0,0 +1,67 @@
+// 用常驻无头 Chrome（CDP）取渲染后的 DOM。
+// 用法: node cdp_get.cjs <url> <outfile> [port] [idleMs]
+// idleMs: 页面 complete 之后再等多久让 JS 灌数据，默认 2500
+const fs = require('fs');
+const path = require('path');
+
+const url = process.argv[2];
+const out = process.argv[3] || 'page_dump.html';
+const port = parseInt(process.argv[4] || '9222', 10);
+const idleMs = parseInt(process.argv[5] || '2500', 10);
+if (!url) { console.error('need url'); process.exit(2); }
+
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+(async () => {
+  let targetId = null;
+  try {
+    const r = await fetch(`http://127.0.0.1:${port}/json/new?${encodeURIComponent(url)}`, {
+      method: 'PUT', signal: AbortSignal.timeout(10000),
+    });
+    if (!r.ok) throw new Error('new tab failed: HTTP ' + r.status);
+    const t = await r.json();
+    targetId = t.id;
+    if (!t.webSocketDebuggerUrl) throw new Error('no ws url');
+
+    const ws = new WebSocket(t.webSocketDebuggerUrl);
+    await new Promise((res, rej) => { ws.onopen = res; ws.onerror = () => rej(new Error('ws error')); });
+
+    const pending = new Map();
+    ws.onmessage = ev => {
+      const m = JSON.parse(ev.data);
+      if (m.id && pending.has(m.id)) { pending.get(m.id)(m); pending.delete(m.id); }
+    };
+    let seq = 0;
+    const send = (method, params) => new Promise(res => {
+      const id = ++seq;
+      pending.set(id, res);
+      ws.send(JSON.stringify({ id, method, params }));
+    });
+
+    // 等 readyState=complete，最多 30s
+    let ready = false;
+    for (let i = 0; i < 120; i++) {
+      await sleep(250);
+      const r2 = await send('Runtime.evaluate', {
+        expression: 'document.readyState', returnByValue: true,
+      });
+      if (r2?.result?.result?.value === 'complete') { ready = true; break; }
+    }
+    await sleep(idleMs);
+
+    const r3 = await send('Runtime.evaluate', {
+      expression: 'document.documentElement.outerHTML', returnByValue: true,
+    });
+    const html = r3?.result?.result?.value || '';
+    fs.writeFileSync(path.join(__dirname, out), html, 'utf8');
+    console.log(`ready=${ready} len=${html.length} title=${JSON.stringify((await send('Runtime.evaluate', { expression: 'document.title', returnByValue: true }))?.result?.result?.value || '')} -> ${out}`);
+    ws.close();
+  } catch (e) {
+    console.error('ERR ' + e.message);
+    process.exitCode = 1;
+  } finally {
+    if (targetId) {
+      try { await fetch(`http://127.0.0.1:${port}/json/close/${targetId}`, { method: 'PUT' }); } catch (_) {}
+    }
+  }
+})();
