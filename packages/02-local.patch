@@ -0,0 +1,290 @@
+/*! Copyright (c) 2026 iinukami and contributors.
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Additional terms under AGPLv3 Section 7: see LICENSE-ADDITIONAL.
+ */
+import { appendFile, readdir, readFile, writeFile } from "node:fs/promises";
+import { resolve } from "node:path";
+import { modelUsageDetails } from "./model-usage.ts";
+
+const DAY_MS = 86400000;
+
+function dayOf(instant: number, timeZone: string) {
+  return new Intl.DateTimeFormat("en-CA", {
+    timeZone, year: "numeric", month: "2-digit", day: "2-digit",
+  }).format(new Date(instant));
+}
+
+/** 判官不在任何会话里跑，它的用量单独落一行流水。 */
+export function judgeUsagePath(root: string) {
+  return resolve(root, "memory/usage-judge.jsonl");
+}
+
+/** 追加一笔判官用量；格式与会话里的 request_usage 一致，账本才认。 */
+export async function appendUsageRecord(root: string, usage: any) {
+  try {
+    const line = JSON.stringify({ type: "usage", role: "assistant", judge: true, request_usage: usage });
+    await appendFile(judgeUsagePath(root), line + "\n");
+  } catch {
+    // 记账是旁路：写不进去就算了，不打断对话。
+  }
+}
+
+/** Sessions keep one jsonl per month; every assistant row may carry request_usage. */
+async function episodeFiles(root: string) {
+  const base = resolve(root, "memory/sessions");
+  let sessions: string[];
+  try { sessions = await readdir(base); } catch { return []; }
+  // 判官流水跟会话放在一起扫，账本不用为它多写一份聚合逻辑。
+  const files: string[] = [judgeUsagePath(root)];
+  for (const id of sessions) {
+    const dir = resolve(base, id, "episodes");
+    let names: string[];
+    try { names = await readdir(dir); } catch { continue; }
+    for (const name of names) if (name.endsWith(".jsonl")) files.push(resolve(dir, name));
+  }
+  return files;
+}
+
+export type UsageBucket = {
+  day: string;
+  provider: string;
+  model: string;
+  requests: number;
+  input: number;
+  output: number;
+  priced: number;
+  unpriced: number;
+  exact: boolean;
+  min: { CNY: number; USD: number };
+  max: { CNY: number; USD: number };
+};
+
+/** Re-price stored usage with the current price book: old rows were written before rates existed. */
+export async function collectUsage(root: string, config: any, days: number): Promise<UsageBucket[]> {
+  const timeZone = config.timezone || "Australia/Brisbane";
+  const now = Date.now();
+  const wanted = new Set<string>();
+  for (let i = 0; i < days; i++) wanted.add(dayOf(now - i * DAY_MS, timeZone));
+  const providers = new Map<string, any>((config.providers || []).map((p: any) => [p.id, p]));
+  const buckets = new Map<string, UsageBucket>();
+  for (const file of await episodeFiles(root)) {
+    let text: string;
+    try { text = await readFile(file, "utf8"); } catch { continue; }
+    if (!text.includes("request_usage")) continue;
+    for (const line of text.split("\n")) {
+      if (!line.includes("request_usage")) continue;
+      let row: any;
+      try { row = JSON.parse(line); } catch { continue; }
+      const usage = row?.request_usage;
+      if (!usage?.measured_at) continue;
+      const at = Date.parse(usage.measured_at);
+      if (!Number.isFinite(at)) continue;
+      const day = dayOf(at, timeZone);
+      if (!wanted.has(day)) continue;
+      const key = `${day}|${usage.provider_id}|${usage.model}`;
+      const bucket = buckets.get(key) ?? {
+        day, provider: String(usage.provider_id ?? "?"), model: String(usage.model ?? "?"),
+        requests: 0, input: 0, output: 0, priced: 0, unpriced: 0, exact: true,
+        min: { CNY: 0, USD: 0 }, max: { CNY: 0, USD: 0 },
+      };
+      bucket.requests += 1;
+      bucket.input += Number.isSafeInteger(usage.input_tokens) ? usage.input_tokens : 0;
+      bucket.output += Number.isSafeInteger(usage.output_tokens) ? usage.output_tokens : 0;
+      const provider = providers.get(usage.provider_id);
+      const hit = usage.cache?.hit_tokens, miss = usage.cache?.miss_tokens;
+      const raw = {
+        prompt_tokens: usage.input_tokens,
+        completion_tokens: usage.output_tokens,
+        ...(Number.isSafeInteger(hit) && Number.isSafeInteger(miss)
+          ? { prompt_cache_hit_tokens: hit, prompt_cache_miss_tokens: miss } : {}),
+      };
+      const cost = provider
+        ? modelUsageDetails(raw, { ...provider, model: usage.model }, new Date(at)).cost
+        : null;
+      if (!cost) bucket.unpriced += 1;
+      else {
+        bucket.priced += 1;
+        bucket.min[cost.currency] += cost.min;
+        bucket.max[cost.currency] += cost.max;
+        // Peak windows carry a range, so the exact figure is unknown for those rows.
+        if (cost.amount === null) bucket.exact = false;
+      }
+      buckets.set(key, bucket);
+    }
+  }
+  return [...buckets.values()].sort((a, b) => (b.input + b.output) - (a.input + a.output));
+}
+
+export type HourBucket = {
+  hour: number;
+  provider: string;
+  model: string;
+  requests: number;
+  input: number;
+  output: number;
+  exact: boolean;
+  unpriced: number;
+  min: { CNY: number; USD: number };
+  max: { CNY: number; USD: number };
+};
+
+/** 浠婂ぉ锛堟寜閰嶇疆鏃跺尯锛夋瘡灏忔椂銆佹瘡妯″瀷鐨勭敤閲忥紝鐢ㄦ潵鐢?24 灏忔椂鍫嗗彔鏌便€?*/
+export async function collectHourly(root: string, config: any) {
+  const timeZone = config.timezone || "Australia/Brisbane";
+  const today = dayOf(Date.now(), timeZone);
+  const hourOf = (instant: number) => {
+    const text = new Intl.DateTimeFormat("en-GB", {
+      timeZone, hour: "2-digit", hourCycle: "h23",
+    }).format(new Date(instant));
+    const hour = Number(text);
+    if (!Number.isFinite(hour)) return 0;
+    return hour === 24 ? 0 : hour;
+  };
+  const providers = new Map<string, any>((config.providers || []).map((p: any) => [p.id, p]));
+  const buckets = new Map<string, HourBucket>();
+  for (const file of await episodeFiles(root)) {
+    let text: string;
+    try { text = await readFile(file, "utf8"); } catch { continue; }
+    if (!text.includes("request_usage")) continue;
+    for (const line of text.split("\n")) {
+      if (!line.includes("request_usage")) continue;
+      let row: any;
+      try { row = JSON.parse(line); } catch { continue; }
+      const usage = row?.request_usage;
+      if (!usage?.measured_at) continue;
+      const at = Date.parse(usage.measured_at);
+      if (!Number.isFinite(at)) continue;
+      if (dayOf(at, timeZone) !== today) continue;
+      const hour = hourOf(at);
+      const key = `${hour}|${usage.provider_id}|${usage.model}`;
+      const bucket = buckets.get(key) ?? {
+        hour, provider: String(usage.provider_id ?? "?"), model: String(usage.model ?? "?"),
+        requests: 0, input: 0, output: 0, exact: true, unpriced: 0,
+        min: { CNY: 0, USD: 0 }, max: { CNY: 0, USD: 0 },
+      };
+      bucket.requests += 1;
+      bucket.input += Number.isSafeInteger(usage.input_tokens) ? usage.input_tokens : 0;
+      bucket.output += Number.isSafeInteger(usage.output_tokens) ? usage.output_tokens : 0;
+      const provider = providers.get(usage.provider_id);
+      const hit = usage.cache?.hit_tokens, miss = usage.cache?.miss_tokens;
+      const raw = {
+        prompt_tokens: usage.input_tokens,
+        completion_tokens: usage.output_tokens,
+        ...(Number.isSafeInteger(hit) && Number.isSafeInteger(miss)
+          ? { prompt_cache_hit_tokens: hit, prompt_cache_miss_tokens: miss } : {}),
+      };
+      const cost = provider
+        ? modelUsageDetails(raw, { ...provider, model: usage.model }, new Date(at)).cost
+        : null;
+      if (!cost) bucket.unpriced += 1;
+      else {
+        bucket.min[cost.currency] += cost.min;
+        bucket.max[cost.currency] += cost.max;
+        if (cost.amount === null) bucket.exact = false;
+      }
+      buckets.set(key, bucket);
+    }
+  }
+  return { day: today, hours: [...buckets.values()].sort((a, b) => a.hour - b.hour) };
+}
+
+export function budgetPath(root: string) {
+  return resolve(root, "memory/usage-budget.json");
+}
+
+export async function readBudget(root: string) {
+  try { return JSON.parse((await readFile(budgetPath(root), "utf8")).replace(/^\uFEFF/, "")); }
+  catch { return null; }
+}
+
+const money = (value: number, currency: string) => `${currency === "CNY" ? "¥" : "$"}${value.toFixed(4)}`;
+const kilo = (value: number) => value.toLocaleString("en-US");
+
+export function registerUsageTools(tools: any, root: string, config: any) {
+  const disposers = [
+    tools.register({
+      name: "usage_today",
+      description:
+        "查最近若干天各 provider 与模型的 token 用量和参考金额，数据取自会话记录的 request_usage。只统计、不拦截；金额按当前价目重算，仅供参考，不是账单。",
+      schema: { days: { type: "integer", minimum: 1, maximum: 31 } },
+      danger: "safe",
+      run: async (args: any) => {
+        if (args && Object.keys(args).some(k => k !== "days")) throw Error("仅接受 days；不接受其他参数");
+        const days = Number.isSafeInteger(args?.days) ? args.days : 1;
+        if (days < 1 || days > 31) throw Error("days 应为 1–31 的整数");
+        const rows = await collectUsage(root, config, days);
+        const budget = await readBudget(root);
+        const totals: any = { requests: 0, input: 0, output: 0, min: { CNY: 0, USD: 0 },
+          max: { CNY: 0, USD: 0 }, unpriced: 0 };
+        for (const row of rows) {
+          totals.requests += row.requests;
+          totals.input += row.input;
+          totals.output += row.output;
+          totals.unpriced += row.unpriced;
+          for (const currency of ["CNY", "USD"] as const) {
+            totals.min[currency] += row.min[currency];
+            totals.max[currency] += row.max[currency];
+          }
+        }
+        const lines = rows.map(row => {
+          const amount = ["CNY", "USD"].every(c => row.max[c as "CNY" | "USD"] === 0)
+            ? "无价"
+            : (["CNY", "USD"] as const).filter(c => row.max[c] > 0)
+              .map(c => row.exact ? money(row.min[c], c) : `${money(row.min[c], c)}–${money(row.max[c], c)}`)
+              .join(" / ");
+          return `${row.day} ${row.provider}/${row.model}：${row.requests} 次，入 ${kilo(row.input)}，出 ${kilo(row.output)}，${amount}`;
+        });
+        const totalText = (["CNY", "USD"] as const)
+          .filter(c => totals.max[c] > 0)
+          .map(c => `${money(totals.min[c], c)}–${money(totals.max[c], c)}`)
+          .join(" / ") || "无";
+        return {
+          timezone: config.timezone || "Australia/Brisbane",
+          days,
+          rows,
+          totals,
+          budget: budget ?? null,
+          summary: [
+            `最近 ${days} 天：${totals.requests} 次请求，入 ${kilo(totals.input)}，出 ${kilo(totals.output)} token，参考金额 ${totalText}。`,
+            totals.unpriced ? `其中 ${totals.unpriced} 次不在价目表里，未计价。` : "",
+            ...lines,
+            budget ? `日预算：${budget.tokens ? `${kilo(budget.tokens)} token` : "未设 token 上限"}${budget.amount ? `，${money(budget.amount, budget.currency || "USD")}` : ""}（只记录，不拦截）` : "还没有设日预算。",
+          ].filter(Boolean).join("\n"),
+        };
+      },
+    }),
+    tools.register({
+      name: "budget_set",
+      description:
+        "设置每日用量预算，仅作记录与对照，不会拦截请求。tokens 为每日 token 上限，amount 为每日金额上限，currency 为 CNY 或 USD。",
+      schema: {
+        tokens: { type: ["integer", "null"], minimum: 0 },
+        amount: { type: ["number", "null"], minimum: 0 },
+        currency: { type: "string", enum: ["CNY", "USD"] },
+        note: { type: "string", maxLength: 100 },
+      },
+      danger: "safe",
+      run: async (args: any) => {
+        const allowed = ["tokens", "amount", "currency", "note"];
+        const extra = Object.keys(args ?? {}).filter(k => !allowed.includes(k));
+        if (extra.length) throw Error("不认识的参数：" + extra.join("、"));
+        const tokens = args?.tokens ?? null, amount = args?.amount ?? null;
+        if (tokens !== null && (!Number.isSafeInteger(tokens) || tokens < 0))
+          throw Error("tokens 应为非负整数或 null");
+        if (amount !== null && (!Number.isFinite(amount) || amount < 0))
+          throw Error("amount 应为非负数或 null");
+        const currency = args?.currency ?? "USD";
+        if (!["CNY", "USD"].includes(currency)) throw Error("currency 只能是 CNY 或 USD");
+        const note = args?.note ?? "";
+        if (typeof note !== "string" || note.length > 100) throw Error("note 最多 100 字");
+        const value = { tokens, amount, currency, note, updated_at: new Date().toISOString() };
+        await writeFile(budgetPath(root), JSON.stringify(value, null, 2), "utf8");
+        return {
+          ...value,
+          text: `日预算已记下：${tokens ? `${kilo(tokens)} token` : "无 token 上限"}${amount ? `，${money(amount, currency)}` : ""}。这只是账，不会拦住请求。`,
+        };
+      },
+    }),
+  ];
+  return () => disposers.forEach(dispose => dispose());
+}
