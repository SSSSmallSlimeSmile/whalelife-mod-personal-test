--- /dev/null
+++ b/tools/kan-edit-rail.ps1
@@ -0,0 +1,44 @@
+$ErrorActionPreference = "Stop"
+$path = "K:\WhaleLife\whalelife\core\ui\app.js"
+$enc = New-Object System.Text.UTF8Encoding($false)
+$text = [System.IO.File]::ReadAllText($path, [System.Text.Encoding]::UTF8)
+
+Copy-Item $path "$path.bak-kan-20261116-rail5" -Force
+
+$old = @'
+    // 当前那一节仍按消息真实位置判定，任何时刻只留一条紫线
+    const head = box.scrollTop + Math.min(120, box.clientHeight * 0.3);
+    let active = 0;
+    (this.railTurns || []).forEach((turn, i) => {
+      const node = nodes[turn.from];
+      const from = node ? node.getBoundingClientRect().top - boxRect.top + box.scrollTop : 0;
+      if (from <= head) active = i;
+    });
+    ticks.forEach((tick, i) => tick.classList.toggle("active", i === active));
+'@
+
+$new = @'
+    // 当前那一节：直接拿消息相对视口的位置比，不再掺 scrollTop。
+    // 旧写法假设滚动一定发生在这个容器上；实际一旦滚动落在祖先元素，
+    // scrollTop 恒为 0、每条消息的 rect 却已经在动，于是"全都不超过阈值"，
+    // 高亮永远停在最后一格（勘 2026-11-16 修）。
+    const liveBox = box.getBoundingClientRect();
+    const head = liveBox.top + Math.min(120, box.clientHeight * 0.3);
+    let active = 0;
+    (this.railTurns || []).forEach((turn, i) => {
+      const node = nodes[turn.from];
+      if (!node) return;
+      if (node.getBoundingClientRect().top <= head) active = i;
+    });
+    ticks.forEach((tick, i) => tick.classList.toggle("active", i === active));
+'@
+
+if (-not $text.Contains($old.Replace("`r`n", "`n")) -and -not $text.Contains($old)) { throw "锚点没找到（active 块）" }
+$text = $text.Replace($old, $new)
+
+$text = $text.Replace("  }  async refreshSessionContext() {", "  }`r`n  async refreshSessionContext() {")
+
+[System.IO.File]::WriteAllText($path, $text, $enc)
+node --check $path
+if ($LASTEXITCODE -ne 0) { throw "node --check 失败" }
+"OK"
