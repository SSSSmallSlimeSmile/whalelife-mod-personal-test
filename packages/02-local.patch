@@ -0,0 +1,85 @@
+/*! Copyright (c) 2026 iinukami and contributors.
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Additional terms under AGPLv3 Section 7: see LICENSE-ADDITIONAL.
+ */
+/**
+ * 写入回执：写入类工具写成功后上报证据，宿主绑定本轮归属，收尾回读核验。
+ * 只有回读通过、且收尾时磁盘上的版本仍是回执那一版，才算「已验证写入」。
+ */
+import { createHash } from "node:crypto";
+import { readFile, stat } from "node:fs/promises";
+import { resolve, sep } from "node:path";
+
+/**
+ * 写入证据：由写入类工具在写成功后自己上报，只含它自己知道的操作事实
+ * （实际写入的字节、回读结果）。工具名、调用 ID、轮次由宿主补，不采信工具自报。
+ */
+export type WriteEvidence = {
+  kind: "file_write";
+  path: string;
+  bytes?: number;
+  sha256?: string;
+  read_back: "ok" | "failed";
+  error?: string;
+};
+
+/** 宿主签发后的正式回执：证据 + 宿主自己掌握的归属信息。 */
+export type WriteReceipt = WriteEvidence & {
+  tool: string;
+  plugin: string;
+  call_id: string;
+  round: number;
+};
+
+/** 回复末尾「本轮文件」的一行：只写文件名和可否打开，路径与字节数留在执行档案。 */
+export type FileItem = {
+  path: string;
+  name: string;
+  bytes?: number;
+  ok: boolean;
+  error?: string;
+};
+
+/** 工具侧上报证据用：绝对路径 → 相对工作目录路径；越界返回 undefined。 */
+export function receiptPath(root: string, absolute: string): string | undefined {
+  const base = resolve(root);
+  const target = resolve(String(absolute ?? ""));
+  if (!target || target === base || !target.startsWith(base + sep)) return undefined;
+  return target.slice(base.length).replace(/^[\\/]+/, "").replaceAll("\\", "/");
+}
+
+/**
+ * 收尾核验：按路径取最后一条回执，回读一次磁盘。
+ * 回读失败、文件不见了、或者内容已经不是回执那一版，都不算已验证。
+ */
+export async function verifiedFiles(root: string, receipts: WriteReceipt[]): Promise<FileItem[]> {
+  const latest = new Map<string, WriteReceipt>();
+  for (const receipt of receipts) latest.set(receipt.path, receipt);
+  const files: FileItem[] = [];
+  for (const [path, receipt] of latest) {
+    const name = path.split("/").pop() ?? path;
+    if (receipt.read_back !== "ok") {
+      files.push({ path, name, ok: false,
+        error: "写入后回读失败：" + (receipt.error ?? "未取到校验值") });
+      continue;
+    }
+    try {
+      const absolute = resolve(root, path);
+      const info = await stat(absolute);
+      if (!info.isFile()) {
+        files.push({ path, name, ok: false, error: "核验时不是普通文件" });
+        continue;
+      }
+      const digest = createHash("sha256").update(await readFile(absolute)).digest("hex");
+      if (receipt.sha256 && digest !== receipt.sha256) {
+        files.push({ path, name, ok: false, error: "写入后文件已变化，与回执版本不一致" });
+        continue;
+      }
+      files.push({ path, name, bytes: info.size, ok: true });
+    } catch (error: any) {
+      const code = error?.code === "ENOENT" ? "文件不存在" : String(error?.code ?? error?.message ?? "读不到");
+      files.push({ path, name, ok: false, error: "核验时读不到：" + code });
+    }
+  }
+  return files;
+}
