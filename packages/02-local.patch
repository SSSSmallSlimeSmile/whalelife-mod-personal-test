@@ -0,0 +1,63 @@
+/*! Copyright (c) 2026 iinukami and contributors.
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Additional terms under AGPLv3 Section 7: see LICENSE-ADDITIONAL.
+ */
+import { readFileSync } from "node:fs";
+
+/** 形如 ${ENV:NAME} 的引用，指向环境变量，不把凭据本身写进配置文件。 */
+const REFERENCE = /^\$\{ENV:([A-Za-z_][A-Za-z0-9_]*)\}$/;
+
+/**
+ * 把 ${ENV:NAME} 换成环境变量的值。
+ * 不是引用形式的字符串原样返回；引用但变量为空时返回空串。
+ */
+export function expandSecret(
+  value: unknown,
+  env: NodeJS.ProcessEnv = process.env,
+): string {
+  const raw = typeof value === "string" ? value.trim() : "";
+  if (!raw) return "";
+  const match = REFERENCE.exec(raw);
+  if (!match) return raw;
+  return String(env[match[1]] ?? "").trim();
+}
+
+/** 配置里是否是环境变量引用（而不是明文凭据）。 */
+export function isSecretReference(value: unknown): boolean {
+  return typeof value === "string" && REFERENCE.test(value.trim());
+}
+
+/**
+ * 从 root/.env 读 KEY=VALUE 注入 process.env。
+ * 已存在的非空变量不覆盖；不打印任何值。返回注入条数。
+ */
+export function loadEnvFile(
+  root: string,
+  env: NodeJS.ProcessEnv = process.env,
+): number {
+  let raw: string;
+  try {
+    raw = readFileSync(`${root}/.env`, "utf8").replace(/^\uFEFF/, "");
+  } catch {
+    return 0;
+  }
+  let loaded = 0;
+  for (const line of raw.split(/\r?\n/)) {
+    const text = line.trim();
+    if (!text || text.startsWith("#")) continue;
+    const at = text.indexOf("=");
+    if (at <= 0) continue;
+    const name = text.slice(0, at).trim();
+    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(name)) continue;
+    let value = text.slice(at + 1).trim();
+    if (
+      (value.startsWith('"') && value.endsWith('"') && value.length >= 2) ||
+      (value.startsWith("'") && value.endsWith("'") && value.length >= 2)
+    )
+      value = value.slice(1, -1);
+    if (env[name]) continue;
+    env[name] = value;
+    loaded += 1;
+  }
+  return loaded;
+}
