diff --git a/tests/tool-protocol.test.ts b/tests/tool-protocol.test.ts
new file mode 100644
index 0000000..af7e4c0
--- /dev/null
+++ b/tests/tool-protocol.test.ts
@@ -0,0 +1,62 @@
+/*! Copyright (c) 2026 iinukami and contributors.
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Additional terms under AGPLv3 Section 7: see LICENSE-ADDITIONAL.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { hasToolProtocol, stripToolProtocol, PROTOCOL_NOTE } from "../core/tool-protocol.ts";
+import { renderHistory } from "../core/provenance.ts";
+
+const BAR = "\uFF5C";
+const open = (tag: string) => `<${BAR}${BAR}DSML${BAR}${BAR} ${tag}>`;
+const close = (tag: string) => `</${BAR}${BAR}DSML${BAR}${BAR} ${tag}>`;
+const block = [
+  open("calls"),
+  open('invoke name="hands_write"'),
+  open('parameter name="path" string="true"') + "tmp/a.md" + close("parameter"),
+  close("invoke"),
+  close("calls"),
+].join("\n");
+
+test("整块协议标记被换成一句说明", () => {
+  const { text, broken } = stripToolProtocol("好的，我来写。\n" + block);
+  assert.equal(broken, true);
+  assert.ok(text.startsWith("好的，我来写。"));
+  assert.ok(text.includes(PROTOCOL_NOTE));
+  assert.ok(!text.includes("hands_write"));
+});
+
+test("未闭合的块按到结尾处理", () => {
+  const { text, broken } = stripToolProtocol("前言\n" + open("calls") + "\n 半截");
+  assert.equal(broken, true);
+  assert.equal(text, "前言\n" + PROTOCOL_NOTE);
+});
+
+test("正文提到这个协议名不算，原样保留", () => {
+  const body = "DSML 是 DeepSeek 的工具调用标记，这段只是讨论。";
+  assert.equal(hasToolProtocol(body), false);
+  assert.deepEqual(stripToolProtocol(body), { text: body, broken: false });
+});
+
+test("空串与普通回复不受影响", () => {
+  assert.deepEqual(stripToolProtocol(""), { text: "", broken: false });
+  assert.deepEqual(stripToolProtocol("今天没什么事。"), { text: "今天没什么事。", broken: false });
+});
+
+test("只有标记时给出说明，不留空", () => {
+  const { text, broken } = stripToolProtocol(block);
+  assert.equal(broken, true);
+  assert.equal(text, PROTOCOL_NOTE);
+});
+
+test("历史里只清洗助手发言，工具结果和用户原文不动", () => {
+  const messages = renderHistory([
+    { role: "user", content: "把这段贴过来：\n" + block },
+    { role: "assistant", content: "我读了。\n" + block },
+    { role: "tool", content: JSON.stringify({ ok: true, result: block }) },
+  ]);
+  assert.ok(messages[0].content.includes("hands_write"), "用户原文不该被改");
+  assert.ok(!messages[1].content.includes("hands_write"), "助手发言里的标记要剔除");
+  assert.ok(messages[1].content.includes(PROTOCOL_NOTE));
+  assert.ok(messages[2].content.includes("hands_write"), "工具结果不该被改");
+});
