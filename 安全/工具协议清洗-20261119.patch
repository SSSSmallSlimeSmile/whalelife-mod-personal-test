+
+/**
+ * 流式正文守卫。
+ * 工具调用退化成正文时，会带出工具协议标记（DSML 一类）。这类文本发到界面
+ * 会被当成普通回复，用户分不清是坏了还是在说话。这里拦下来并明说。
+ * 标记可能跨 chunk，所以尾部留 64 字节做哨兵，其余即时放行。
+ */
+export function guardStream(send: (value: any) => void) {
+  const keep = 64;
+  const needle = "<｜｜DSML｜｜";
+  let tail = "";
+  let isBroken = false;
+  return {
+    get broken() {
+      return isBroken;
+    },
+    push(text: string) {
+      if (isBroken) return;
+      const joint = tail + text;
+      const at = joint.indexOf(needle);
+      if (at >= 0) {
+        isBroken = true;
+        const head = joint.slice(0, at);
+        if (head) send({ type: "chunk", text: head });
+        send({
+          type: "chunk",
+          text: "\n\n[工具协议异常] 这一轮的工具调用没有真正执行，上面的内容不可信。请重发指令，或换个会话再试。\n",
+        });
+        tail = "";
+        return;
+      }
+      if (joint.length > keep) {
+        send({ type: "chunk", text: joint.slice(0, joint.length - keep) });
+        tail = joint.slice(joint.length - keep);
+      } else {
+        tail = joint;
+      }
+    },
+    flush() {
+      if (!isBroken && tail) send({ type: "chunk", text: tail });
+      tail = "";
+    },
+  };
+}
