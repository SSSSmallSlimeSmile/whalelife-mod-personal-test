+/*! Copyright (c) 2026 iinukami and contributors.
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Additional terms under AGPLv3 Section 7: see LICENSE-ADDITIONAL.
+ */
+/**
+ * 工具协议标记的识别与剔除。
+ *
+ * 工具调用退化成正文时，模型把协议标记当普通文字吐出来。这些文字进了历史，
+ * 就成了下一轮请求里的"示范"，越滚越多。这里只做一件事：把整块标记换成一句
+ * 说明，其余文字一个字节都不动。
+ *
+ * 判别依据是标签本身（<｜｜DSML｜｜ …），不是"DSML"这个词——正文里正常讨论
+ * 这个协议时不该被拦。
+ */
+export const PROTOCOL_NOTE = "［工具协议标记：本轮未执行］";
+
+const BLOCK = /<[｜|]{2}DSML[｜|]{2}[\s\S]*?(?:<\/[｜|]{2}DSML[｜|]{2}\s*calls>|$)/g;
+const OPENING = /<[｜|]{2}DSML[｜|]{2}/;
+
+/** 粗略判定：这段文字里出现了工具协议标记。用于流式守卫，不用于存储。 */
+export function hasToolProtocol(text: string): boolean {
+  return OPENING.test(text);
+}
+
+/** 整块剔除协议标记；未闭合的块按到结尾处理。 */
+export function stripToolProtocol(text: string): { text: string; broken: boolean } {
+  if (!text || !hasToolProtocol(text)) return { text, broken: false };
+  const cleaned = text.replace(BLOCK, PROTOCOL_NOTE).trim();
+  return { text: cleaned || PROTOCOL_NOTE, broken: true };
+}
